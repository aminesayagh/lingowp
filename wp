#!/usr/bin/env bash
# ponytail: wraps ../../../../bin/wp so it can be run from this plugin dir
set -Eeuo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)"
cd "$ROOT"
docker compose exec --user www-data -e HOME=/tmp \
  --workdir /var/www/html/wp-content/plugins/translangs \
  wordpress wp --path=/var/www/html "$@"
