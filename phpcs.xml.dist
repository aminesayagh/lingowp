<?xml version="1.0"?>
<ruleset name="LingoWP Security">
	<description>Security sniffs only. Style/formatting is deliberately out of scope.</description>

	<file>lingowp.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>templates</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>
	<exclude-pattern>*/security-reports/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.2"/>

	<!-- Escaping, sanitizing, nonces, capability checks. -->
	<rule ref="WordPress.Security"/>

	<!-- Exception messages are logged, never rendered to a browser. -->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
	</rule>

	<!-- Silenced errors and clobbered WP globals hide security bugs. -->
	<rule ref="WordPress.PHP.NoSilencedErrors"/>
	<rule ref="WordPress.WP.GlobalVariablesOverride"/>

	<!--
		WordPress.DB.PreparedSQL* is deliberately NOT enabled here, but it is NOT
		blind to `$this->wpdb`: Plugin Check (what WordPress.org runs) reports it.
		Every query therefore sits in a `phpcs:disable ... -- reason` /
		`phpcs:enable` block. A one-line `phpcs:ignore` is not enough: it covers
		only the next line, and a multi-line prepare() is reported on its
		argument lines. Keep the blocks when editing queries.

		Gate: `composer run security:plugin-check` must report only the three
		name/slug warnings (verified 2026-10-16, 1.6.1).
		SQL also stays covered by security/semgrep-wp.yml, rule
		`wpdb-query-without-prepare`.
	-->

	<!-- bin/ is developer CLI tooling: echo to a terminal is not output escaping. -->
</ruleset>
